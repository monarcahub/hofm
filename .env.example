# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Project URL: https://qqzvmwbweuaybkymkldi.supabase.co
VITE_SUPABASE_URL="https://qqzvmwbweuaybkymkldi.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# SUPABASE SERVER-SIDE SERVICE ROLE KEY (Never expose to client)
# Configured in server environment / AI Studio Secrets for administrative operations:
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"

# N8N WEBHOOK CONFIGURATION (WhatsApp template notifications & Patient Code Recovery)
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_TOKEN=""
PATIENT_RECOVERY_WEBHOOK_URL="https://webhook.monarcahub.com/webhook/recupera-acesso"

